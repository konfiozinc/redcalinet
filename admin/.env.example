# Nombres de configuración; no contiene credenciales. Copiar solo a un .env privado no versionado.

# ---------- QA local (emuladores en loopback) ----------
RCL_MODE=emulator
GCLOUD_PROJECT=demo-redcalinet-admin
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PORT=5176
# Adaptador QA de subida directa: imita el endpoint firmado del proveedor en
# loopback. Solo puede activarse con RCL_MODE=emulator; nunca en producción.
RCL_TEST_MEDIA=direct

# ---------- Producción (candidata; no completar aquí) ----------
# Contrato recibido. Producción bloqueada hasta certificación conjunta y autorización.
# RCL_MODE=production
# GCLOUD_PROJECT=red-calinet
# RCL_CONTRACT_APPROVED_HASH=<hash de admin/contract.json ya promovido a HARNESS_VERIFIED>
# RCL_PUBLIC_ORIGIN=https://<origen-del-panel>,https://<origen-del-sitio>
# FIREBASE_WEB_API_KEY=<configuración pública real>
# FIREBASE_AUTH_DOMAIN=<dominio-auth-real>
# RCL_FUNCTIONS_REGION=us-central1

# ---------- Multimedia (Cloudinary) ----------
# El api_secret NUNCA va en este archivo ni en el repositorio. En producción vive
# en Secret Manager y se enlaza a la función; Cloud Functions lo expone como
# process.env.CLOUDINARY_API_SECRET:
#   firebase functions:secrets:set CLOUDINARY_API_SECRET --project red-calinet
# La subida real exige las cinco condiciones a la vez; si falta una, falla cerrado:
#   RCL_MEDIA_MODE=cloudinary · CLOUDINARY_CLOUD_NAME · CLOUDINARY_API_KEY
#   CLOUDINARY_API_SECRET (Secret Manager) · RCL_CLOUDINARY_QUOTA_REVIEWED=yes
# RCL_MEDIA_MODE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=        # SOLO Secret Manager, jamás aquí
# RCL_CLOUDINARY_QUOTA_REVIEWED=yes

# ---------- Credenciales de servicio ----------
# ADC: identidad de servicio fuera del código, sin versionar claves.
# GOOGLE_APPLICATION_CREDENTIALS apunta a un JSON FUERA del repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\fuera\del\repositorio\servicio.json
