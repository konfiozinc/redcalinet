# Nombres de configuración; no contiene credenciales. Copiar solo a un .env privado no versionado.
RCL_MODE=emulator
GCLOUD_PROJECT=demo-redcalinet-admin
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PORT=5176
# QA únicamente, nunca producción:
RCL_TEST_MEDIA=fixture
